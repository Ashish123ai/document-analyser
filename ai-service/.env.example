# Shared secret. The Node backend sends it in the X-Internal-Key header. Must match backend/.env
AI_INTERNAL_KEY=change-me-internal-key

# --- LLM ---
# anthropic | openai | mock
#   mock = no API key needed. Answers are extractive and analysis uses rule-based detection only.
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
# For Groq, put your Groq API key in OPENAI_API_KEY. This also supports other OpenAI-compatible servers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Embeddings ---
# Any sentence-transformers model, or "hashing" for a tiny offline embedder (tests/demos only)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking (characters). MiniLM reads about 256 tokens (~1000 chars), so keep chunks below that. ---
CHUNK_SIZE=900
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=64

# --- Retrieval ---
TOP_K=5
MIN_RELEVANCE=0.22
RERANKER_MODEL=none

# --- Storage ---
CHROMA_DIR=./data/chroma
TEXT_DIR=./data/texts
MAX_UPLOAD_MB=200
