# Used by docker-compose. For local (non-Docker) development use the .env.example inside each service folder.

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AI_INTERNAL_KEY=

CLIENT_URL=http://localhost:8080

# anthropic | openai | mock   (mock needs no key: extractive answers + rule-based analysis)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: real password-reset emails. If empty the reset link is printed in the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
