# Used by docker-compose. For local (non-Docker) development use the .env.example inside each service folder.

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AI_INTERNAL_KEY=
MAX_UPLOAD_MB=200
AI_TIMEOUT_MS=600000
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=64
RERANKER_MODEL=none

CLIENT_URL=http://localhost:8081
FRONTEND_PORT=8081

# anthropic | openai | mock   (mock needs no key: extractive answers + rule-based analysis)
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
# For Groq, put your Groq API key here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: real password-reset emails. If empty the reset link is printed in the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
