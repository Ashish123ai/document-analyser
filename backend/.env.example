NODE_ENV=development
PORT=5000

# MongoDB (local or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/legal_analyzer

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=7d

# Frontend origin (CORS + password reset links)
CLIENT_URL=http://localhost:5173

# Python AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_KEY=change-me-internal-key
AI_TIMEOUT_MS=180000

# Uploads (kept outside any public/static folder)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Email for password reset. If SMTP_HOST is empty, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Legal Analyzer <no-reply@legal-analyzer.local>"
